{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course",
    "description": "A complete Intelligence Academy course detail page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "rating": {
      "type": "decimal",
      "min": 0,
      "max": 5,
      "default": 0
    },
    "reviewCount": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "learnerCount": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "level": {
      "type": "enumeration",
      "enum": ["Beginner", "Intermediate", "Advanced", "All Levels"],
      "default": "Beginner",
      "required": true
    },
    "badges": {
      "type": "component",
      "component": "course.badge",
      "repeatable": true
    },
    "about": {
      "type": "component",
      "component": "shared.paragraph",
      "repeatable": true
    },
    "learningOutcomes": {
      "type": "component",
      "component": "shared.text-item",
      "repeatable": true
    },
    "audiences": {
      "type": "component",
      "component": "course.audience",
      "repeatable": true
    },
    "modules": {
      "type": "component",
      "component": "course.module",
      "repeatable": true
    },
    "includes": {
      "type": "component",
      "component": "shared.text-item",
      "repeatable": true
    },
    "totalDuration": {
      "type": "string",
      "required": true
    },
    "totalLessons": {
      "type": "integer",
      "min": 0,
      "default": 0,
      "required": true
    },
    "instructor": {
      "type": "component",
      "component": "course.instructor",
      "repeatable": false,
      "required": true
    },
    "reviews": {
      "type": "component",
      "component": "course.review",
      "repeatable": true
    },
    "relatedCourses": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::course.course"
    }
  }
}
